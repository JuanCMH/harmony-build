# Copia este archivo como `.env.local`. `bunx convex dev` escribe las dos
# primeras por ti al enlazar el proyecto de Convex.

# Deployment que usa `bunx convex dev`
CONVEX_DEPLOYMENT=

# Cliente de Convex en el navegador. Sin ella la aplicación no arranca.
NEXT_PUBLIC_CONVEX_URL=

# Observabilidad (opcional). Sin la clave, los errores se quedan en consola.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Cuenta con la que corre la suite de Playwright (`bun run test:e2e`). Sólo
# contra un deployment de desarrollo: la suite crea la cuenta si no existe.
E2E_EMAIL=
E2E_PASSWORD=

# Las de autenticación NO van aquí: viven en el deployment de Convex y se
# definen con `bunx convex env set` (ver README, «Conectar con Convex»):
#   SITE_URL, JWT_PRIVATE_KEY, JWKS, AUTH_RESEND_KEY,
#   AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET
